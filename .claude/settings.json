{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes prettier --write --ignore-path .gitignore \"$CLAUDE_FILE_PATH\" 2>/dev/null"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm --filter @launchpad/api --filter @launchpad/db -r lint 2>&1 && pnpm build 2>&1 || { echo '^^ Stop hook: lint or build failed — blocking session exit'; exit 1; }"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
